* text=auto eol=lf

# Unreal / binary assets
*.uasset binary
*.umap binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp4 binary

# Keep source/config text normalized
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf

# Preserve exact original CMU MoCap bytes including author whitespace.
SourceAssets/Gate12/MotionV3/CMU/*.bvh -text -diff
SourceAssets/Gate12/MotionV3/CMU/READMEFIRST.txt -text -diff
